generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id                 String           @id @default(cuid())
  orderId            String           @unique
  clientName         String
  clientEmail        String?
  clientDocument     String?
  createdAt          DateTime
  vtexStatus         String
  pagarmeStatus      String?
  invoiceNumber      String?
  invoiceKey         String?
  invoicedAt         DateTime?
  carrierName        String?
  trackingCode       String?
  trackingUrl        String?
  totalValue         Decimal?         @db.Decimal(12, 2)
  has48hInvoiceAlert Boolean          @default(false)
  items              Json?
  timeline           Json?
  rawVtexJson        Json?
  rawPagarmeJson     Json?
  lastSyncedAt       DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  payments           PaymentStatus[]
  trackingInfos      TrackingInfo[]
  alerts             OrderAlert[]
  logs               IntegrationLog[]

  @@index([createdAt])
  @@index([vtexStatus])
  @@index([pagarmeStatus])
  @@index([has48hInvoiceAlert])
}

model PaymentStatus {
  id            String   @id @default(cuid())
  orderId       String
  provider      String   @default("pagarme")
  status        String
  chargeId      String?
  transactionId String?
  refusalReason String?
  amount        Decimal? @db.Decimal(12, 2)
  rawJson       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

model TrackingInfo {
  id            String   @id @default(cuid())
  orderId       String
  carrierName   String?
  trackingCode  String?
  trackingUrl   String?
  lastStatus    String?
  lastUpdatedAt DateTime?
  history       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderAlert {
  id             String    @id @default(cuid())
  orderId        String
  type           String
  severity       String
  message        String
  probableReason String?
  recommendedAction String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([severity])
  @@index([resolvedAt])
}

model IntegrationLog {
  id           String   @id @default(cuid())
  orderId      String?
  provider     String
  action       String
  status       String
  message      String
  requestId    String?
  errorCode    String?
  durationMs   Int?
  metadata     Json?
  createdAt    DateTime @default(now())
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([provider])
  @@index([status])
  @@index([createdAt])
}
